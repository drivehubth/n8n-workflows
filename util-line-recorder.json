    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "f-type",
              "leftValue": "={{ $json.type }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "message"
            },
            {
              "id": "f-source",
              "leftValue": "={{ $json.source?.type }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "group"
            },
            {
              "id": "f-msgtype",
              "leftValue": "={{ [\"text\",\"image\",\"sticker\"].includes($json.message?.type ?? \"\") }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },

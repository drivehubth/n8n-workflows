            {
              "id": "cfg-supabase-url",
              "name": "supabase_url",
              "type": "string",
              "value": "={{ $('get env').all().find(r => r.json.name === 'SUPABASE_URL').json.value }}"
            },
            {
              "id": "cfg-msg-table",
              "name": "line_messages_table",
              "type": "string",
              "value": "={{ $('get env').all().find(r => r.json.name === 'LINE_MESSAGES_TABLE').json.value }}"
            },
            {
              "id": "cfg-grp-table",
              "name": "line_groups_table",
              "type": "string",
              "value": "={{ $('get env').all().find(r => r.json.name === 'LINE_GROUPS_TABLE').json.value }}"
            },
            {
              "id": "cfg-bucket",
              "name": "line_media_bucket",
              "type": "string",
              "value": "={{ $('get env').all().find(r => r.json.name === 'LINE_MEDIA_BUCKET').json.value }}"

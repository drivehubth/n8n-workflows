{
  "name": "[Util] LINE — Register",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "1a8b8be9-4b00-4d4b-8527-a9ada5a0723b",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        96
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "environment_variables",
          "mode": "name"
        }
      },
      "id": "94424c6e-9da6-4d14-83e2-d96d35f06248",
      "name": "get env",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        224,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-sheet-url",
              "name": "dealer_group_mapping_sheet_url",
              "value": "={{ $('get env').all().find(r => r.json.name === 'DEALER_GROUP_MAPPING_SHEET_URL').json.value }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a498a287-3b8c-4646-bb48-18c1b164e96e",
      "name": "config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-type",
              "leftValue": "={{ $json.type }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "message"
            },
            {
              "id": "c-msgtype",
              "leftValue": "={{ $json.message?.type }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "text"
            },
            {
              "id": "c-source",
              "leftValue": "={{ $json.source?.type }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "group"
            },
            {
              "id": "c-register",
              "leftValue": "={{ ($json.message?.text ?? '').trim() }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "rightValue": "#register"
            }
          ]
        },
        "options": {}
      },
      "id": "c906a4cd-ed0f-4192-a3aa-17f65bcd14e9",
      "name": "Filter Register Message",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-groupid",
              "name": "groupId",
              "value": "={{ $json.source.groupId }}",
              "type": "string"
            },
            {
              "id": "a-replytoken",
              "name": "replyToken",
              "value": "={{ $json.replyToken }}",
              "type": "string"
            },
            {
              "id": "a-dealercode",
              "name": "dealerCode",
              "value": "={{ $json.message.text.trim().replace(/^#register/i, '').trim() }}",
              "type": "string"
            },
            {
              "id": "a-rawtext",
              "name": "rawText",
              "value": "={{ $json.message.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "3e4e93de-ad71-435a-afee-ff8e09c5fc0c",
      "name": "Extract Register Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "url": "=https://api.line.me/v2/bot/group/{{ $json.groupId }}/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {}
      },
      "id": "902c6ce3-8fcd-4bd9-96a0-8b8cb8dba77d",
      "name": "Get Group Name",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        192
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBearerAuth": {
          "id": "wnEM9E2aVqJcfDpe",
          "name": "Dealer LINE OA Auth"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('config').first().json.dealer_group_mapping_sheet_url }}",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "dealer_groups",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "group_id": "={{ $json.groupId }}",
            "group_name": "={{ $json.groupName }}",
            "registered_at": "={{ $now.setZone('Asia/Bangkok').toFormat('yyyy-MM-dd HH:mm:ss') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "group_id",
              "displayName": "group_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "group_name",
              "displayName": "group_name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "registered_at",
              "displayName": "registered_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "9fd7020b-daa4-4bde-af5a-ead223ee7e5f",
      "name": "Append Mapping",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        896,
        192
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2Z58mnLNDfs33OTR",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ replyToken: $('Extract Register Event').item.json.replyToken, messages: [{ type: 'text', text: '✅ ลงทะเบียนกลุ่มเรียบร้อย\\nกลุ่ม: ' + $('Get Group Name').item.json.groupName }] }) }}",
        "options": {}
      },
      "id": "8b4c963d-e8c6-4a5f-b45d-37c8d216c664",
      "name": "Reply Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        192
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "wnEM9E2aVqJcfDpe",
          "name": "Dealer LINE OA Auth"
        }
      }
    }
